.env
.env.*
!.env.example

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local databases, dumps and backups
*.sqlite
*.sqlite3
*.db
db.json
*.dump
*.sql
*.bak
*.backup
backups/

# editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# docker (local only)
Dockerfile
compose.yaml
compose.dev.yaml
docker-compose.yml
.dockerignore
nginx.conf
